# ============================================================================
# Evidence Engine — variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# `.env.local` está en .gitignore: los secretos NUNCA se commitean.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) SESIÓN / AUTENTICACIÓN
# ---------------------------------------------------------------------------
# Secreto para firmar el cookie de sesión (JWT). Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Usuarios del equipo (administrados manualmente — NO hay registro).
# Formato:  email:NombreVisible:contraseña   separados por coma.
# La contraseña puede ir en texto plano aquí (solo en tu .env.local privado)
# o como hash bcrypt con el prefijo "bcrypt$" para mayor seguridad.
# Ejemplo:
#   PORTAL_USERS="diana@simon.com:Diana:Simon2025!,javier@simon.com:Javier:Clave123"
PORTAL_USERS="diana@simon.com:Diana:cambiar-contrasena"

# ---------------------------------------------------------------------------
# 2) GOOGLE (Drive + Sheets)  —  cuenta de servicio
# ---------------------------------------------------------------------------
# Si NO defines estas variables, el portal funciona en MODO LOCAL:
# los archivos se guardan en ./.data y el historial en un JSON local.
# En cuanto las definas, empieza a escribir en Drive y Sheets de verdad.
#
# Pasos:
#  1. Crea una cuenta de servicio en Google Cloud y descarga su JSON.
#  2. Habilita las APIs "Google Drive API" y "Google Sheets API".
#  3. Comparte la carpeta de Drive y la hoja de cálculo con el email
#     de la cuenta de servicio (client_email) como Editor.
#
# El JSON completo de la cuenta de servicio, en UNA sola línea:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la carpeta de Google Drive donde se subirán los archivos
# (lo tomas de la URL: drive.google.com/drive/folders/<ESTE_ID>)
GOOGLE_DRIVE_FOLDER_ID=

# ID de la Google Sheet donde se registra el historial
# (lo tomas de la URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=

# Nombre de la pestaña dentro de la hoja (por defecto: Historial)
GOOGLE_SHEET_TAB="Historial"
